(use-modules (guix packages)
             (gnu)
             (guix utils)
             (guix git-download)
             (guix download)
             (gnu packages guile)
             (gnu packages gnupg)
             (gnu packages guile)
             (gnu packages guile-xyz)
             (gnu packages pkg-config)
             (guix build-system guile)
             (gnu packages rust-apps)
             (gnu packages linux)
             (gnu packages compression)
             (gnu packages vim)
             (gnu packages tls)
             (gnu packages texinfo)
             (gnu packages autotools)
             ((guix licenses)
              #:prefix license:))

(define-public guile-veritas
  (package
    (name "guile-veritas")
    (version "0.9.0")
    (source
     (origin
       (method git-fetch)
       (uri (git-reference
             (url "https://github.com/jjba23/veritas.git")
             (commit (string-append "v" version))))
       (file-name (git-file-name name version))
       (sha256
        (base32 "1pr8yjnxkrp2fylmn8ihjapin7iz94jqi4hbc6yd0ajll11ajxc9"))))
    (build-system guile-build-system)
    (arguments
     (list
      #:source-directory "src"))
    (native-inputs (list guile-3.0))
    (propagated-inputs (list guile-fibers
                             guile-json-4)) ;; for versions >= 2.0.0
    (home-page "https://github.com/jjba23/veritas")
    (synopsis "Testing framework for Guile")
    (description
     "Veritas is a testing framework for Guile with an @acronym{EDSL,
embedded domain specific language} to define test suites.  Emphasis is placed
on legible, maintainable tests.  Veritas shuffles tests and runs them
concurrently by default.")
    (license license:lgpl3+)))

(packages->manifest
 (list guile-3.0-latest
       ;; Runtime: libgcrypt bindings (guile-uuid needs them too, and the
       ;; native AES/PBKDF2 layer speaks to libgcrypt through Guile's FFI).
       guile-gcrypt
       guile-uuid
       ;; Development and testing.
       guile-veritas
       guile-ares-rs
       guile-documenta
       texinfo
       watchexec
       ;; Optional: not needed to build, run or test bewaking. It is here so the
       ;; published interoperability vectors can be regenerated by hand.
       openssl))
